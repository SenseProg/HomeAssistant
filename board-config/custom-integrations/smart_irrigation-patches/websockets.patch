+def _html_to_plain(text: str) -> str:
+    """Перетворити HTML-пояснення розрахунку на читабельний простий текст.
+
+    ЛОКАЛЬНИЙ ПАТЧ HomeMate. Панель Info вставляє це значення як текст
+    (view-info.ts: ${this.info.irrigation_explanation} без unsafeHTML), тому
+    користувач бачив сирі <br/>, <ol> і <li> прямо в інтерфейсі. Панель Zones
+    показує те саме поле через unsafeHTML, тому в сховищі текст лишається
+    HTML - перетворення робиться лише тут, на шляху до Info.
+
+    Пункти списку нумеруються, бо у .explanation-text немає white-space,
+    і переноси рядків усе одно схлопнулися б у пробіли.
+    """
+    step = [0]
+
+    def _number(_match: "re.Match[str]") -> str:
+        step[0] += 1
+        return f" {step[0]}) "
+
+    out = re.sub(r"<li>", _number, text)
+    out = out.replace("</li>", "").replace("<ol>", " ").replace("</ol>", " ")
+    out = re.sub(r"<br\s*/?>", " ", out)
+    out = re.sub(r"<[^>]+>", "", out)
+    return " ".join(out.split())

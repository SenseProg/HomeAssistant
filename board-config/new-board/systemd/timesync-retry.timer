[Unit]
Description=Check the clock shortly after boot and keep checking

[Timer]
# 90 s after boot covers the race that left timesyncd dead; every 10 minutes
# afterwards covers the router rebooting or the link flapping, both of which
# happen on this board.
OnBootSec=90s
OnUnitActiveSec=600s
AccuracySec=10s

[Install]
WantedBy=timers.target

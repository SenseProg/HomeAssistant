[Unit]
Description=Reach the Tenda/camera segment through the spare board
# This board cannot reach 192.168.50.2 (Tenda AC10), .175 or .201 (the
# Hikvision camera) at all - 0 of 10 pings on 2026-08-14, while the NAS on the
# same interface answers 10 of 10. Not a cable fault: rx_errors and
# rx_crc_errors are both 0, and a static ARP entry for the camera did not help,
# so the traffic is blocked below IP. The spare board (192.168.50.150) reaches
# all three and relays them - see camera-relay.service there.
#
# Host routes only. Nothing else changes path, so if the spare board is off,
# only these three hosts are lost and the house keeps working.
# accept_redirects stays off: the relay sits in the same subnet, and an ICMP
# redirect would otherwise send this board straight back to the path that does
# not work.
#
# Delete this once the board's cable moves to a port that reaches that segment.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'sysctl -q -w net.ipv4.conf.all.accept_redirects=0; sysctl -q -w net.ipv4.conf.eth0.accept_redirects=0'
ExecStart=/bin/sh -c 'for d in 192.168.50.201 192.168.50.2 192.168.50.175; do ip route replace "$d/32" via 192.168.50.150 dev eth0 src 192.168.50.141; done'
ExecStop=/bin/sh -c 'for d in 192.168.50.201 192.168.50.2 192.168.50.175; do ip route del "$d/32" via 192.168.50.150 dev eth0 2>/dev/null || true; done'

[Install]
WantedBy=multi-user.target

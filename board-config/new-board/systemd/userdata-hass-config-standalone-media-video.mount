[Unit]
Description=NAS share for Home Assistant camera clips (read-write)
# Mounted on the canonical path, NOT /userdata/hass/config/media/video: systemd
# refuses any mount whose path contains a symlink ("Mount path is not canonical
# (contains a symlink)" / "Too many levels of symbolic links", measured
# 2026-08-13), and switch-mode.sh makes /userdata/hass/config a symlink to this
# very directory. Home Assistant still finds the archive at its usual path,
# because that symlink resolves to exactly this location.
After=network-online.target
Wants=network-online.target

[Mount]
What=192.168.50.25:/HomeAssistant
Where=/userdata/hass/config-standalone/media/video
Type=nfs
Options=rw,soft,timeo=100,retrans=3,noatime,nolock,_netdev

[Install]
WantedBy=multi-user.target

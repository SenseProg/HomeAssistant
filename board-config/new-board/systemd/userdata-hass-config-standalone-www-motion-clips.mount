[Unit]
Description=Expose NAS motion clips under www so HA can serve them at /local
After=userdata-hass-config\x2dstandalone-media-video.mount
Requires=userdata-hass-config\x2dstandalone-media-video.mount

[Mount]
What=/userdata/hass/config-standalone/media/video/ha-motion
Where=/userdata/hass/config-standalone/www/motion-clips
Type=none
Options=bind

[Install]
WantedBy=multi-user.target

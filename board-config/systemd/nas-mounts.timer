[Unit]
Description=Retry the NAS mounts after boot and whenever the NAS comes back

[Timer]
# 20 s after boot covers the race that broke them; the minute-by-minute run
# covers the NAS rebooting, the switch being unplugged, or Wi-Fi dropping - the
# archive comes back on its own instead of waiting for someone to notice.
OnBootSec=20s
OnUnitActiveSec=60s
AccuracySec=5s

[Install]
WantedBy=timers.target

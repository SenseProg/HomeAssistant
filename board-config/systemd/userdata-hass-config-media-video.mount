[Unit]
Description=NAS share for Home Assistant camera clips (read-write)
After=network-online.target
Wants=network-online.target

[Mount]
What=192.168.50.25:/HomeAssistant
Where=/userdata/hass/config/media/video
Type=nfs
Options=rw,soft,timeo=100,retrans=3,noatime,nolock,_netdev

[Install]
WantedBy=multi-user.target

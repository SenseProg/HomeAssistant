[Unit]
Description=NAS camera clips (read-write)
After=network-online.target
Wants=network-online.target

[Mount]
# Confirm this exact path with showmount -e after enabling the QNAP NFS ACL.
What=192.168.50.25:/Відєоспостереження
Where=/userdata/hass/config/media/video
Type=nfs
Options=rw,soft,timeo=100,retrans=3,noatime,nolock,_netdev

[Install]
WantedBy=multi-user.target

[Unit]
Description=Cloudflare tunnel publishing Home Assistant from the spare board
# Stand-in for the tunnel on the house board, which went off the network on
# 2026-08-17 19:08. Its credentials could not be retrieved - they are on that
# board - so this is a separate tunnel (ha-spare) and ha.sonyachny.pp.ua was
# repointed at it with "cloudflared tunnel route dns --overwrite-dns".
#
# When the house board returns, its own cloudflared-ha.service will start and
# serve nothing, because the DNS record now points here. Repoint it back and
# disable this one, otherwise the address keeps showing the spare board.
#
# Home Assistant on this board is deliberately NOT enabled at boot: two
# instances holding LocalTuya sessions to the same valves and pump is the one
# failure here that can break something physical.
After=network-online.target home-assistant.service
Wants=network-online.target

[Service]
Type=simple
User=forlinx
ExecStart=/usr/local/bin/cloudflared --config /home/forlinx/.cloudflared/config.yml --no-autoupdate tunnel run
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target

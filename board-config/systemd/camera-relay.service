[Unit]
Description=Relay the house board to the network segment it cannot reach
# The board that runs the house (192.168.50.141, eth0) cannot reach the Tenda
# AC10 at .2, the camera at .201 or .175 - measured 2026-08-14: 0 of 10 pings,
# while the NAS answers 10 of 10 over the same interface, the error counters
# are clean (rx_errors 0, rx_crc_errors 0) and a static ARP entry changes
# nothing. Those hosts sit in a segment its cable does not bridge to. This
# board reaches all of them, so it relays for them.
#
# MASQUERADE is required, not plain forwarding: otherwise the camera would
# answer 192.168.50.141 directly and the reply would die in the same isolated
# segment. send_redirects must stay off, or this board would tell the house
# board "go direct" and break the path it just provided.
#
# This is a stopgap. Moving the house board's cable to the port this board
# uses removes both the need for it and the dependency on this board staying
# powered on.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'sysctl -q -w net.ipv4.ip_forward=1'
ExecStart=/bin/sh -c 'sysctl -q -w net.ipv4.conf.all.send_redirects=0; sysctl -q -w net.ipv4.conf.eth1.send_redirects=0'
ExecStart=/bin/sh -c 'for d in 192.168.50.201 192.168.50.2 192.168.50.175; do iptables -t nat -C POSTROUTING -d "$d" -o eth1 -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -d "$d" -o eth1 -j MASQUERADE; done'
ExecStop=/bin/sh -c 'for d in 192.168.50.201 192.168.50.2 192.168.50.175; do iptables -t nat -D POSTROUTING -d "$d" -o eth1 -j MASQUERADE 2>/dev/null || true; done'

[Install]
WantedBy=multi-user.target

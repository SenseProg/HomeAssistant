[Unit]
Description=Expose NAS motion clips under www so HA can serve them at /local
# HA refuses to follow symlinks out of www, and files under media/ need auth.
# A bind mount looks like a real directory and costs no disk - the data stays
# on the NAS share mounted at media/video.
After=userdata-hass-config-media-video.mount
Requires=userdata-hass-config-media-video.mount

[Mount]
What=/userdata/hass/config/media/video/ha-motion
Where=/userdata/hass/config/www/motion-clips
Type=none
Options=bind

[Install]
WantedBy=multi-user.target
